# ---------------------------------------------------------------------------
# Template for apps/api/.env and apps/web/.env.local
# Copy, do not rename. Never commit a filled-in copy. (BUILD_ROADMAP Appendix 4)
# ---------------------------------------------------------------------------

# --- apps/api/.env ---------------------------------------------------------

# Neon pooled connection string
DATABASE_URL=

PORT=3001
WEB_ORIGIN=http://localhost:3000

# Server-side only. Must NEVER acquire a NEXT_PUBLIC_ prefix (E37).
OPENAI_API_KEY=

# Pinned at step B2 (vision) and B3 (text)
VISION_MODEL=
TEXT_MODEL=

# false -> full graceful-degradation path (E23): the doctor can still
# write and save consultations with no AI at all.
LLM_ENABLED=true

LOG_LEVEL=info


# --- apps/web/.env.local ---------------------------------------------------

# The only variable in this project that is safe to expose to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
